<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppThemeNoActionBarBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:statusBarColor">@color/systemBarBackground</item>
        <item name="android:navigationBarColor">@color/systemBarBackground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@style/AppThemeNoActionBarBase" />

    <style name="AppThemeNoActionBarLaunchBase" parent="Theme.SplashScreen">
        <!-- Scope the splash to the window. A theme-wide view background also
             reaches WebView select rows, giving each row the splash image's
             minimum height and hiding the remaining filter options. -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/appBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/systemBarBackground</item>
        <item name="android:navigationBarColor">@color/systemBarBackground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="@style/AppThemeNoActionBarLaunchBase" />
</resources>
