# Databases
*.db
*.db-*
*.db-wal
*.db-shm

# Logs
*.log
backend/artifacts/*.json
backend/artifacts/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
gitleaks-report.*
secret-scan-report.*

# Android private distribution and signing secrets
*.jks
*.keystore
frontend/android/key.properties
frontend/android/app/release/
