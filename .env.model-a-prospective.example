# Example only: keep real credentials in a separate untracked env file.
# All collection gates default to false. Configure and validate the scope before activation.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
MODEL_A_PROSPECTIVE_COLLECTION_ENABLED=false
MODEL_A_PROSPECTIVE_ENABLED=false
MODEL_A_PROSPECTIVE_RESULTS_REFRESH_ENABLED=false
MODEL_A_PROSPECTIVE_MONITORING_ENABLED=false
MODEL_A_PROSPECTIVE_REQUIRE_RIGOROUS_INPUTS=false
MODEL_A_COLLECTION_PROTOCOL_ID=
MODEL_A_COLLECTION_MANIFEST_SHA256=
MODEL_A_COLLECTION_SEASONS=
MODEL_A_COLLECTION_FROM=
MODEL_A_COLLECTION_TO=
MODEL_A_COLLECTION_INTERVAL_SECONDS=300
MODEL_A_COLLECTION_PREDICT_BUDGET_MS=30000
MODEL_A_COLLECTION_CONFIRMATION_BUDGET_MS=45000
# Optional research calendar only. Requires an authorized free provider account,
# reviewed provider-team -> Understat-team ID mapping and a NEW pinned protocol.
MODEL_A_RESEARCH_CALENDAR_ENABLED=false
FOOTBALL_DATA_ORG_API_KEY=
MODEL_A_RESEARCH_CALENDAR_MAPPING_JSON=
MODEL_A_RESEARCH_CALENDAR_EXPECTED_TEAM_COUNTS={"Serie A":20,"Premier League":20,"La Liga":20,"Bundesliga":18,"Ligue 1":18}
MODEL_A_RESEARCH_CALENDAR_MAX_AGE_SECONDS=3600
