# Copy this file to .env in the repository root and replace placeholders.
# Single source of truth for local Docker and root helper scripts.
# Do not commit real secrets. Rotate any credentials that were exposed in past commits.

# Shared / Docker orchestration
TZ=Europe/Rome
FRONTEND_PORT=3000
AUTO_SYNC_ON_BOOT=false
NIGHTLY_ORCHESTRATOR=github_actions

# Shared personal admin access. Production fails closed if the hash is absent.
# Generate the scrypt hash with `npm run auth:hash` in backend, passing the
# password through standard input. Never place the plain password in this file.
SHARED_ADMIN_AUTH_ENABLED=true
SHARED_ADMIN_PASSWORD_HASH=scrypt-hash-placeholder
SHARED_DATA_USER_ID=user1
SHARED_ADMIN_SESSION_TTL_MS=1209600000
SHARED_ADMIN_LOGIN_WINDOW_MS=900000
SHARED_ADMIN_MAX_LOGIN_ATTEMPTS=5
SHARED_ADMIN_MAX_TRACKED_LOGIN_IPS=5000
CORS_ORIGIN=https://scommese-sportive-frontend.hostless.site,https://localhost

# Backend only - database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Backend only - odds providers
ODDS_API_KEY=your-odds-api-key
THE_ODDS_API_KEY=your-odds-api-key
ODDS_PRIMARY_PROVIDER=odds_api
# Optional authorized role key for the same provider account; no quota/key rotation.
ODDS_API_T15_KEY=
# All keys for one subscription MUST share this stable scope, including across processes.
ODDS_API_ACCOUNT_SCOPE=primary
# Planning caps; provider response headers remain the authority on measured consumption.
ODDS_API_MONTHLY_CREDITS=500
ODDS_API_RESERVE_CREDITS=50
# Preliminary views reuse cached data. Opt-in network requests must preserve the reserve.
ODDS_INFORMATIONAL_NETWORK_ENABLED=false
ODDS_EXTRA_EVENT_NETWORK_ENABLED=false
ODDS_EVENT_TIMEOUT_MS=60000
ODDS_PROVIDER_MATCH_TIMEOUT_MS=45000
ODDS_PROVIDER_COMPETITION_TIMEOUT_MS=60000
ODDS_MATCH_ROUTE_TIMEOUT_MS=60000

# Players and lineups temporarily paused; stored statistics are preserved.
PLAYER_DATA_ENABLED=false
PLAYER_AVAILABILITY_ENABLED=false
LINEUP_REFRESH_SCHEDULER_ENABLED=false
REACT_APP_PLAYER_AVAILABILITY_ENABLED=false
REACT_APP_PLAYER_DATA_ENABLED=false
# Optional official lineups/availability (API-Football free tier: 100 req/day).
# The free endpoint supplies confirmed lineups near kickoff; probable XI is
# calculated internally by the backend 24h before kickoff.
API_FOOTBALL_ENABLED=false
API_FOOTBALL_KEY=
API_FOOTBALL_TIMEOUT_MS=15000
# Account sospeso / credenziali non valide: pausa condivisa fra endpoint (secondi).
API_FOOTBALL_AUTH_COOLDOWN_SECONDS=900

# Backend only - Understat scheduler
UNDERSTAT_SCHEDULER_ENABLED=false
UNDERSTAT_SCHEDULER_TIME=01:00
UNDERSTAT_SCHEDULER_MODE=top5
UNDERSTAT_SCHEDULER_COMPETITION=Serie A
UNDERSTAT_SCHEDULER_YEARS_BACK=1
UNDERSTAT_SCHEDULER_IMPORT_PLAYERS=true
UNDERSTAT_SCHEDULER_INCLUDE_MATCH_DETAILS=true
UNDERSTAT_SCHEDULER_FORCE_REFRESH=false
UNDERSTAT_DETAIL_CONCURRENCY=10

# Backend only - odds snapshots
ODDS_SNAPSHOT_SCHEDULER_ENABLED=false
ODDS_SNAPSHOT_SCHEDULER_TIME=02:15
ODDS_SNAPSHOT_RUN_ON_BOOT=true
ODDS_SNAPSHOT_INTERVAL_HOURS=24
ODDS_SNAPSHOT_COMPETITIONS=Serie A,Premier League,La Liga,Bundesliga,Ligue 1
ODDS_SNAPSHOT_MARKETS=h2h,totals,spreads
ODDS_MATCH_CACHE_TTL_SECONDS=180

# Backend only - learning reviews
LEARNING_REVIEW_SCHEDULER_ENABLED=false
LEARNING_REVIEW_SCHEDULER_TIME=03:00
LEARNING_REVIEW_RUN_ON_BOOT=false
LEARNING_REVIEW_INTERVAL_HOURS=24
LEARNING_REVIEW_MATCH_LIMIT=50
SCHEDULER_RUN_RETENTION=100

# Independent remote T-15 virtual betting. Keep disabled until acceptance gates pass.
# Requires a dedicated always-on worker, trained compatible C and validated markets.
# Target kickoff minus 15 minutes; maximum lateness 60 seconds; stale prices (>5min) rejected.
RESEARCH_T15_SCHEDULER_ENABLED=false
# Legacy registration stays retired even if an old environment enables it.
AUTO_BET_ENABLED=false
# Local/CI training only: Python 3.12 with backend/ml/requirements.txt.
RESEARCH_PYTHON=python

# Backend only - backtesting
BACKTEST_ROUTE_TIMEOUT_MS=600000

# Frontend local dev
# The React dev server does not require dedicated runtime secrets.
# FRONTEND_PORT above is used by Docker port mapping and root helper scripts.
